# ---- Opportunity Radar configuration ----
# Copy to .env and fill in what you have. Everything is optional; the app runs
# in demo mode without any credentials.

# Model provider. Without any key the app still discovers, researches, verifies facts,
# builds rule-based hypotheses, scores and writes template drafts; a model adds subtler
# facts/hypotheses and personalized drafts. Set one or both keys; AI_PROVIDER picks
# (auto = Anthropic first, then OpenAI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# Models (empty = provider default: claude-opus-5-5 / gpt-5 for investigation,
# claude-opus-5-5 / gpt-5-mini for outreach). Effort controls cost/quality per stage.
AI_INVESTIGATE_MODEL=
AI_INVESTIGATE_EFFORT=medium
AI_OUTREACH_MODEL=
AI_OUTREACH_EFFORT=medium

# Hard spending guard: the worker refuses to start AI work once the estimated
# cumulative spend recorded in the database exceeds this (USD).
AI_SPEND_LIMIT_USD=25

# Google Places API (New). Optional secondary discovery provider.
# Review Google's Places API policies on caching before enabling.
GOOGLE_PLACES_API_KEY=

# Website finder (for businesses discovered without a website, or whose recorded
# site is dead). auto = Brave Search when BRAVE_SEARCH_API_KEY is set, otherwise
# verified domain guesses only. duckduckgo = keyless HTML endpoint, opt-in (bot
# challenges were observed). off = guesses only.
WEB_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=

# Texas sales tax permit registry (free open data, no key). Optional free Socrata app
# token raises rate limits: https://data.texas.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Overture Maps Places (primary discovery source): bulk open data read with DuckDB from
# the public S3 release, no key. Needs a long-lived host (disabled automatically on
# serverless). Bump OVERTURE_RELEASE monthly; results are cached per area.
OVERTURE_ENABLED=true
OVERTURE_RELEASE=2026-10-21.0
OVERTURE_CACHE_DAYS=30

# Headless-browser rendering for JavaScript-only sites (local hosts only).
RESEARCH_BROWSER_RENDER=true
# Research older than this many days is shown as stale.
RESEARCH_STALE_DAYS=60

# Off-site public records during investigation (RDAP registration year, DNS MX/SPF
# email hosting and senders, Internet Archive first capture). Keyless. true/false.
RESEARCH_FOOTPRINT=true
# Try to locate a website when a business has none (or its site is unreachable).
RESEARCH_FIND_WEBSITE=true

# OpenStreetMap (default discovery provider, no key needed).
# Public instances are shared and rate-limited; use a paid/self-hosted
# instance for sustained commercial volume.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
# Identifies this app to OSM services (required by their usage policies).
OSM_USER_AGENT=opportunity-radar/0.1 (set-your-contact-email@example.com)

# Website research limits
RESEARCH_MAX_PAGES=5
RESEARCH_PAGE_BYTES_LIMIT=1500000
RESEARCH_FETCH_TIMEOUT_MS=10000
RESEARCH_CONCURRENCY=4

# Database: local SQLite file by default. For cloud/serverless hosting set a
# hosted libSQL (Turso) database instead; it is persistent and shared.
DATABASE_PATH=./data/radar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Background worker: run inside the Next.js server process (default) or as a
# separate `pnpm worker` process (set to false then).
EMBEDDED_WORKER=true
