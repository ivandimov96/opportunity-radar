# ---- Opportunity Radar configuration ----
# Copy to .env and fill in what you have. Keys and passwords live here and only
# here: they are never stored in the database and never reach the browser.
# Everything else (who you are, sending limits, automation) is under Settings in the app.

# ---- AI: research, email writing, claim checks, reading replies ----
# Without a key the app still finds businesses, reads their websites and builds
# the profile, but ideas come from fixed rules and wait for your review, and no
# email is written. Set one key; AI_PROVIDER picks when both exist.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto
# Models (empty = provider default, claude-opus-5-5 for Anthropic). Effort controls cost and depth.
AI_INVESTIGATE_MODEL=
AI_INVESTIGATE_EFFORT=medium
AI_OUTREACH_MODEL=
AI_OUTREACH_EFFORT=medium
# AI spend allowed per calendar month in USD (Settings → Automation can override it).
# Measured: about $0.13 per researched business and $0.04 per written and checked email.
AI_SPEND_LIMIT_USD=30

# ---- Finding businesses: Google Maps listings through Serper (serper.dev) ----
# Sign-up gives 2,500 free credits (no card) that do not renew; a page of 20
# listings costs 3 credits. Pages are cached, so repeating a search is free.
SERPER_API_KEY=
SERPER_CREDIT_BUDGET=2500
SERPER_MAX_PAGES=3
SERPER_CACHE_DAYS=30

# ---- Website research: Firecrawl (firecrawl.dev) ----
# The only way pages are fetched. Free plan: 1,000 credits a month, 1 credit per
# page. A business costs 2 credits when it has no public email (research stops
# there) and up to RESEARCH_MAX_PAGES otherwise. Stored pages are reused for
# RESEARCH_STALE_DAYS days and re-analysis is free.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_CONCURRENCY=2
FIRECRAWL_RPM=10
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_MONTHLY_CREDIT_BUDGET=1000
RESEARCH_MAX_PAGES=6
RESEARCH_CONCURRENCY=4
RESEARCH_STALE_DAYS=60
# Stop research after the homepage and contact page when no public email is
# found (there is nobody to write to). false = research every business fully.
RESEARCH_REQUIRE_EMAIL=true
# Off-site public records (domain registration year, mail servers, first archive capture). Keyless.
RESEARCH_FOOTPRINT=true
# Try to locate a website when a listing has none, or its site is dead.
RESEARCH_FIND_WEBSITE=true
# Web search for the website finder: auto = Brave when BRAVE_SEARCH_API_KEY is set, otherwise verified domain guesses only.
# Brave Search is paid by use since February 2026 (a small monthly credit, a card required): leave empty to spend nothing.
WEB_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
# Whole-city searches look the city boundary up once (cached); identify yourself to the service.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
OSM_USER_AGENT=opportunity-radar/0.1 (set-your-contact-email@example.com)

# ---- Mailbox: where outreach is sent from and replies are read ----
# Create an APP PASSWORD in your mailbox's security settings (never your normal
# password) and set three lines. Nothing is ever sent without your approval of
# each email and your click on "Send approved emails".
#   gmail (Gmail and Google Workspace) | yahoo | icloud | zoho | fastmail | outlook | custom | fake
# custom needs MAIL_SMTP_HOST and MAIL_IMAP_HOST. fake keeps everything in memory (tests, dry runs).
MAIL_PROVIDER=
MAIL_USER=
MAIL_PASSWORD=
# The address in From; defaults to MAIL_USER.
MAIL_FROM=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
# Mailboxes connected in Settings store their app password encrypted with this key (falls back to AUTH_SECRET).
# Set it once, at least 16 characters, and do not change it: stored passwords cannot be read with another key.
MAILBOX_SECRET=
# "Sign in with Microsoft" for a mailbox (Outlook, Hotmail, Microsoft 365). Register an app in Microsoft Entra
# (entra.microsoft.com > App registrations; accounts in any organisation and personal accounts), add the web
# redirect address <site>/auth/microsoft/mailbox/callback, create a client secret, and add the delegated
# permissions IMAP.AccessAsUser.All and SMTP.Send (Office 365 Exchange Online) plus offline_access.
# The site's public address (https://app.yourdomain.com), used for the redirect back. Optional: the request's own host is used otherwise.
APP_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Storage and worker ----
# A local SQLite file. For a hosted deployment set a libSQL (Turso) database instead.
DATABASE_PATH=./data/radar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The background worker runs inside the app (default) or as `pnpm worker` (set to false then).
EMBEDDED_WORKER=true

# Signs the session cookie (any long random text, at least 16 characters). Required in production.
AUTH_SECRET=

# "Continue with Google" on the sign-in and sign-up pages (optional). Create an OAuth client of type
# "Web application" in the Google Cloud console and register the redirect address
# http://localhost:3000/auth/google/callback (and the same path on your real site).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
