# ---- Opportunity Radar configuration: PRODUCTION ----
# The live product. These values are set on the host (Vercel: Project, Settings, Environment Variables,
# environment "Production"), or in .env.production.local when production runs from a machine of your own
# (`pnpm build`, `pnpm start`, `pnpm worker:prod`). Every value here is production's own: none is copied
# from development. `pnpm env:check production` checks a local file. .env.example explains each setting
# at length; this list is what production must have, and what it should not.

# ---- Must be set ----
# The hosted database (Turso). Only production opens it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Signs the session cookie. Long random text (openssl rand -base64 32). Changing it signs everybody out.
AUTH_SECRET=
# Encrypts the mailbox passwords customers connect. Long random text. Set it once and never change it:
# with another key the stored passwords cannot be read and every mailbox must be connected again.
MAILBOX_SECRET=
# The public address of the product, with https and no slash at the end. Links in emails and the
# sign-in redirects use it.
APP_URL=
# Protects the address that runs the queued jobs on a serverless host. Long random text.
CRON_SECRET=

# ---- The paid services: keys made for production, with their own budgets ----
ANTHROPIC_API_KEY=
AI_SPEND_LIMIT_USD=30
SERPER_API_KEY=
SERPER_CREDIT_BUDGET=2500
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_CREDIT_BUDGET=1000

# ---- Signing in ----
# The same OAuth apps may serve both environments, but each address must be registered in them:
#   Google:    <APP_URL>/auth/google/callback
#   Microsoft: <APP_URL>/auth/microsoft/callback  and  <APP_URL>/auth/microsoft/mailbox/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# open (default) or waitlist.
SIGNUP_MODE=open

# ---- The product's own emails (confirm your address, choose a new password) ----
# A sender of the product's own, from any SMTP service. Customers rely on these: do not send them from
# a personal mailbox in production.
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_MAIL_FROM=

# ---- Must NOT be set in production ----
# MAIL_PROVIDER=fake      the test mailbox: the app refuses to start with it
# DATABASE_PATH           ignored while the hosted database is set
# DEV_REMOTE_DATABASE     a development switch
# MAIL_USER / MAIL_PASSWORD   every workspace connects its own mailbox in Settings
